# ============================================
# My-Blog 生产环境变量模板
# 复制为 .env 并填入真实值（不要提交 .env 到 git）
# 用法：docker compose --env-file .env up -d
# ============================================

# Django 密钥（必填，生产环境必须使用高强度随机字符串）
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# 调试模式（生产环境必须为 False）
DEBUG=False

# 允许访问的主机域名（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================
# PostgreSQL 数据库配置
# 生产环境采用宿主机原生 PostgreSQL（非容器），且 web 容器使用 host 网络模式，
# 因此容器内 127.0.0.1:5432 即宿主机 PostgreSQL（已生产验证）。
# 本地开发若使用独立 db 容器，可改为 db 容器名并调整网络模式。
# ============================================
DB_NAME=myblog
DB_USER=myblog_user
DB_PASSWORD=MyBlog_Passw0rd
# host 网络模式下，127.0.0.1 即宿主机 PostgreSQL
DATABASE_URL=postgresql://myblog_user:MyBlog_Passw0rd@127.0.0.1:5432/myblog
